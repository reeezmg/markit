{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx zenstack generate && nuxt build",
  "crons": [
    {
      "path": "/api/cron/crm",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/ecommerce-cms/marketing/process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/recurring-expenses",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/recurring-invoices",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/after-sales",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/loans",
      "schedule": "30 1 * * *"
    }
  ]
}
