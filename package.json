{
    "name": "nuxt-ui-pro-template-dashboard",
    "private": true,
    "type": "module",
    "version": "0.0.1-prealpha.1",
    "scripts": {
        "dev": "nuxt dev",
        "dev:web": "nuxt dev --port 3000",
        "build": "nuxt build",
        "generate": "nuxt generate",
        "prodgenerate": "nuxt generate --dotenv .env.production",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "typecheck": "nuxt typecheck",
        "test": "tsx tests/payroll-attendance-shift.test.ts && tsx --test tests/shift-policy.test.ts tests/holiday-settings.test.ts tests/attendance-calendar-request.test.ts tests/salary-safety.test.ts",
        "test:user-credit": "tsx --test tests/user-credit-input.test.ts",
        "test:billing": "node tests/billing/run.mjs",
        "test:recurring-expenses": "tsx tests/recurring-expenses.test.ts && tsx tests/recurring-expenses.integration.test.ts",
        "test:account-ledger": "tsx tests/account-ledger-reconciliation.test.ts",
        "test:accountant": "tsx tests/accountant-v2-pages.test.ts && tsx tests/accountant-v2.integration.test.ts",
        "db:accountant": "node scripts/apply-accountant-v2.mjs",
        "db:distributor-accounting": "node scripts/apply-distributor-accounting.mjs && node scripts/apply-distributor-accounting.mjs --history-projection && node scripts/apply-distributor-accounting.mjs --purchase-tax && node scripts/apply-distributor-accounting.mjs --receipt-consistency",
        "test:distributor-accounting": "tsx tests/distributor-accounting-pages.test.ts && tsx tests/distributor-accounting.integration.test.ts",
        "test:company-scope": "tsx tests/company-scope.test.ts",
        "test:erp-company-pages": "tsx tests/erp-company-pages.test.ts",
        "test:products-distributor-company-pages": "tsx tests/products-distributor-company-pages.test.ts",
        "test:users-clients-company-pages": "tsx tests/users-clients-company-pages.test.ts",
        "test:account-ledger:writeflow": "tsx tests/account-ledger-writeflow.test.ts",
        "test:legacy-accounting-disconnect": "tsx tests/legacy-accounting-disconnect.test.ts && node tests/legacy-accounting-policy.test.mjs && tsx tests/legacy-company-transfer.integration.test.ts",
        "db:erp-accounting": "node scripts/apply-distributor-accounting.mjs --erp && node scripts/apply-distributor-accounting.mjs --erp-deleted-sources && node scripts/apply-distributor-accounting.mjs --expense-tax && node scripts/apply-distributor-accounting.mjs --erp-parties && node scripts/apply-distributor-accounting.mjs --customer-accounts",
        "test:erp-accounting": "tsx tests/erp-accounting.integration.test.ts",
        "db:import-erp-history": "node scripts/import-erp-history.mjs",
        "db:import-cash-bank": "node scripts/import-legacy-cash-bank.mjs",
        "test:cash-bank-import": "node tests/legacy-cash-bank-plan.test.mjs && node tests/legacy-cash-bank-import.integration.test.mjs",
        "test:accountant-money": "tsx tests/accountant-money.integration.test.ts",
        "test:erp-accounting:api": "tsx tests/erp-accounting-api.integration.test.ts",
        "test:products-distributor-accounting:api": "tsx tests/products-distributor-accounting-api.integration.test.ts",
        "db:stock-accounting": "node scripts/apply-distributor-accounting.mjs --stock",
        "db:reconcile-stock": "node scripts/reconcile-stock-accounting.mjs",
        "test:stock-accounting": "node tests/stock-accounting.integration.test.mjs",
        "db:production-accounting": "node scripts/production-accounting/run.mjs",
        "test:production-accounting": "node tests/production-accounting.test.mjs",
        "test:user-accounting": "tsx tests/user-accounting.integration.test.ts",
        "test:user-accounting:api": "tsx tests/user-accounting-api.integration.test.ts",
        "db:user-accounting": "node scripts/production-accounting/apply-distributor-accounting.mjs --users && node scripts/production-accounting/apply-distributor-accounting.mjs --user-credit-baseline",
        "db:connect-user-accounting": "tsx scripts/production-accounting/connect-user-accounting.ts",
        "test:customer-accounting": "npm run test:bill-receipts && npm run test:bill-receipts:readonly",
        "test:bill-receipts": "tsc -p tests/tsconfig.credit-receipts.json && tsc -p tests/tsconfig.reports.json && tsx --tsconfig tests/tsconfig.credit-receipts.json --test tests/bill-receipts.test.ts tests/billing/credit-receipts.test.ts tests/bill-stock-lifecycle.test.ts tests/receipt-source-guards.test.ts",
        "test:bill-receipts:readonly": "tsx --tsconfig tests/tsconfig.credit-receipts.json tests/bill-receipts.readonly.test.ts",
        "test:transaction-history": "node tests/transaction-history.integration.test.mjs",
        "test:document-status": "node tests/document-status-history.integration.test.mjs && tsx tests/document-status-history-api.test.ts",
        "test:ecommerce-accounting": "tsx tests/ecommerce-return.test.ts && tsx tests/ecommerce-accounting.integration.test.ts",
        "db:import-transfers": "tsx scripts/production-accounting/copy-old-account-history.ts --only=transfers",
        "test:transfer-history": "node tests/transfer-history.integration.test.mjs",
        "db:import-transactions": "tsx scripts/production-accounting/copy-old-account-history.ts --only=transactions",
        "db:investors": "node scripts/production-accounting/apply-investors.mjs",
        "db:import-investors": "tsx scripts/production-accounting/copy-old-account-history.ts --only=investments",
        "db:copy-old-account-history": "tsx scripts/production-accounting/copy-old-account-history.ts",
        "test:reports": "tsc -p tests/tsconfig.reports.json && tsx tests/report-gst-source.test.ts && tsx tests/report-accounting.integration.test.ts && tsx tests/report-pages.integration.test.ts",
        "test:investors": "tsx tests/investors.integration.test.ts"
    },
