        "swiper": "^11.2.10",
        "uncrypto": "^0.1.3",
        "uuid": "^9.0.1",
        "v-calendar": "^3.1.2",
        "vue": "^3.5.13",
        "vue-chartjs": "^5.3.2",
        "vue-echarts": "^7.0.3",
        "vue-router": "^4.5.0",
        "vue-tel-input": "^9.3.0",
